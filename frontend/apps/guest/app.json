{
  "expo": {
    "name": "BookDan",
    "slug": "bookdan",
    "scheme": "hotelapp",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "et.bookdan.guest"
    },
    "android": {
      "package": "et.bookdan.guest",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BookDan uses your location to show hotels near you."
        }
      ]
    ],
    "extra": {
      "apiMode": "mock",
      "router": {},
      "eas": {
        "projectId": "caae1dbf-2f8c-4699-ae24-aceff012952e"
      }
    },
    "owner": "elshuworkdan",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/caae1dbf-2f8c-4699-ae24-aceff012952e",
      "checkAutomatically": "ON_LOAD"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B192C"
    }
  }
}
