# Copy to .env for local development. .env is git-ignored. NEVER commit real secrets or paste them into chat.
APP_ENV=development
HTTP_ADDR=:8080
# How phones reach this server (used in payment page links). Production must be https.
PUBLIC_URL=http://localhost:8080

# Supabase (recommended): Project Settings > Database > Connection string > "Session pooler" (port 5432).
# URL-encode special characters in the password. See docs/database.md.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Or local PostgreSQL from docker compose:
# DATABASE_URL=postgres://bookdan:bookdan@localhost:5432/bookdan?sslmode=disable

# Or no database at all: `go run ./cmd/devserver` starts a private one (see docs/going-live.md).

# Demo only. Must be false in production: every sign-in code is 123456.
DEMO_MODE=true

# ---- Secrets. Empty is fine in development (a built-in public value is used). REQUIRED in production.
# Generate each with: openssl rand -base64 32   (JWT_SECRET: any random string of 32+ characters)
JWT_SECRET=
ID_ENCRYPTION_KEY=
VOUCHER_SIGNING_SEED=
PAYMENT_WEBHOOK_SECRET=

# ---- Integrations. The development stand-ins below are refused in production until the real ones are built.
OTP_PROVIDER=log        # SMS codes: log (prints the code) | an SMS provider: to build
EMAIL_PROVIDER=log      # emailed codes: log (prints them) | smtp (really sends)
PAYMENT_PROVIDER=dev    # dev (fake test page)  | telebirr, chapa: to build
PUSH_PROVIDER=log       # log (prints alerts)   | fcm: to build

# ---- Admin web page at /admin (hotels, rooms, prices, photos, staff). Off until ADMIN_PASSWORD is set.
# Platform admins are the emails below; they sign in with the password. Use 16+ random characters for the password.
ADMIN_EMAILS=
ADMIN_PASSWORD=
# Let hotel owners use /admin for their own hotels (they sign in with a code). Turn on ONLY when sign-in codes are real (DEMO_MODE off).
ADMIN_OWNERS=false

# ---- Real sign-in codes by email (EMAIL_PROVIDER=smtp). Works with Gmail (use an APP PASSWORD, not your normal password), Brevo, Mailgun, SES.
# Gmail: turn on 2-step verification, then Google Account > Security > App passwords. Sends as the signed-in address, about 500 emails a day.
# With real email on and DEMO_MODE=true: real addresses get a real random code; DEMO_ACCOUNT_DOMAINS keep the fixed demo code 123456.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
DEMO_ACCOUNT_DOMAINS=bookdan.test,example.com,example.org
